# Copy to the release's private environment file on the target host.
# Replace placeholders through the secret manager; never commit real values.
APP_NAME="Room Booking System"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://booking.example.invalid
LOG_CHANNEL=daily
LOG_LEVEL=info
LOG_DAILY_DAYS=14

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=room_booking_production
DB_USERNAME=room_booking_app
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

CACHE_STORE=redis
CACHE_PREFIX=room-booking-production-cache-
QUEUE_CONNECTION=redis
QUEUE_FAILED_DRIVER=database-uuids
REDIS_CLIENT=phpredis
# Use the same unique app+environment prefix on every node in this environment.
# Use a different prefix for local, staging, and production.
REDIS_PREFIX=room-booking-production:
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE=default
REDIS_QUEUE_RETRY_AFTER=180

SESSION_DRIVER=redis
SESSION_STORE=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Set only the Stripe environment appropriate for the deployment stage.
# For staging, use Stripe Test Mode credentials from a secret manager.
# Production must use production credentials only after a separate approval.
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
# STRIPE_KEY is not consumed by this server-side Checkout implementation.

MAIL_MAILER=smtp
MAIL_HOST=mail.example.invalid
MAIL_PORT=587
MAIL_SCHEME=smtp
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=bookings@example.invalid
MAIL_FROM_NAME="${APP_NAME}"

FILESYSTEM_DISK=local
